{
  "name": "aenimtech/fieldsbox",
  "description": "Reusable PHP/JS meta fields and frontend fields toolkit for custom WordPress plugins.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "version": "1.0.1",
  "authors": [
    {
      "name": "AenimTech",
      "homepage": "https://aenimtech.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Fieldsbox\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
